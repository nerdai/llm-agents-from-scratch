@startuml uml_ch10_llm_agent_a2a_executor_cancel_sequence
!include ../common/book-clean.puml
title LLMAgentA2AExecutor.cancel() — Sequence

participant "A2A server" as server
participant "executor: LLMAgentA2AExecutor" as executor
participant "updater: TaskUpdater" as updater
participant "handler: TaskHandler" as handler

server -> executor : cancel(context, event_queue)
activate executor

executor -> executor : _task_handlers[task_id]
note left: TaskNotFoundError if the\ntask is not in flight

executor -> updater : cancel()
note left: published first, before\nanything that can suspend

executor -> handler : background_task.cancel()
activate handler
handler --> executor : stopped (CancelledError swallowed)
deactivate handler

executor -> handler : cancel() if not done()
note left: the background task and the\nhandler settle separately
deactivate executor

@enduml
