@startuml uml_ch09_use_subagent_tool_dispatch_sequence
!include ../common/book-clean.puml
title UseSubAgentTool Dispatch — Sequence

participant "agent: LLMAgent" as agent
participant "handler: TaskHandler" as handler
participant "tool: UseSubAgentTool" as tool

agent -> handler : creates per run()
hnote right #lightblue: 1
activate handler

group#fffbe6 #FFFFFF process loop
...
handler -> handler : run_step(step)
activate handler
note right of handler: tool calls, and thus subagent\ndispatches, occur in run_step()\ninvocations
handler -> tool : ~__call~__(tool_call)
activate tool

tool -> tool : _subagents_registry[name]
hnote left #lightblue: 2


create participant "subagent: LLMAgent" as subagent
tool -> subagent : spec.builder.build()
hnote left #lightblue: 3

tool -> subagent : run(Task(instruction))
hnote left #lightblue: 4
activate subagent

subagent --> tool : TaskResult, or raises
hnote left #lightblue: 5
deactivate subagent

tool --> handler : ToolCallResult
hnote left #lightblue: 6
deactivate tool
...
note over handler: run_step() carries on from here, and steps repeat\nunder the process loop until the task terminates
end

@enduml
