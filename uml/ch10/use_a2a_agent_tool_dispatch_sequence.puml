@startuml uml_ch10_use_a2a_agent_tool_dispatch_sequence
!include ../common/book-clean.puml
title UseA2AAgentTool Dispatch — Sequence

participant "agent: LLMAgent" as agent
participant "handler: TaskHandler" as handler
participant "tool: UseA2AAgentTool" as tool
participant "A2A server" as peer

agent -> handler : creates per run()
activate handler
handler -> tool : ~__call~__(tool_call)
hnote right #lightblue: 1
activate tool

tool -> tool : _a2a_agents_registry[name]
note left of tool: gets the spec, reads\nurl, headers,\nagent_card, timeout

tool -> tool : opens httpx.AsyncClient\nand A2A client

tool -> peer : send_message(task, task_id?)
peer --> tool : StreamResponse\n(Task or Message)

tool -> tool : closes both clients
hnote left #lightblue: 2

tool -> tool : a2a_response_to_tool_call_result()
hnote left #lightblue: 3
deactivate tool
tool --> handler : ToolCallResult
deactivate handler

@enduml
