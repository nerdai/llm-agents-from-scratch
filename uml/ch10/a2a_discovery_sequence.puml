@startuml uml_ch10_a2a_discovery_sequence
!include ../common/book-clean.puml
title A2A Discovery — Sequence

participant "A2A client" as client
participant "A2A server" as server

client -> server : HTTP GET /.well-known/agent-card.json
note right: standardized by A2A —\na single GET at the\nserver's well-known URI
activate server

server --> client : Agent Cards
deactivate server
note right: one card per agent\nthe server exposes

@enduml
