@startuml uml_ch10_a2a_peer_registration_sequence
!include ../common/book-clean.puml
title Discovering and Registering an A2A Peer — Sequence

actor user
participant "spec: A2AAgentSpec" as spec
participant "agent: LLMAgent" as agent
participant "A2A server" as peer

user -> spec : from_url(url)
hnote right #lightblue: 1
activate spec

spec -> peer : GET /.well-known/agent-card.json
hnote right #lightblue: 2
peer --> spec : AgentCard
hnote right #lightblue: 3

spec -> spec : from_agent_card(agent_card)
hnote left #lightblue: 4
note right: name and url are both\ntaken from the card
deactivate spec
spec --> user : spec

user -> agent : LLMAgent(a2a_agents=[spec])
hnote right #lightblue: 5
agent -> agent : builds a2a_agents_registry
hnote left #lightblue: 6

@enduml
